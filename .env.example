# .env.example - Copy to .env and fill in values
DB_URL=jdbc:oracle:thin:@localhost:1234/FREEPDB1
DB_USERNAME=my_user
DB_PASSWORD=my_password
ORACLE_PWD=my_oracle_password123

HASHID_SALT=generate_random_string_here
HASHID_LENGTH=8
HASHID_ALPHABET=ABCDEF1234567890
JWT_SECRET=generate_256bit_key_here
SELF=my-crm

INITIAL_ADMIN_EMPLOYEE_ID=1111
INITIAL_ADMIN_PASSWORD=adminPass
INITIAL_ADMIN_EMAIL=email@example.com
INITIAL_ADMIN_PHONE=11111111
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=Admin

INITIAL_MANUAL_TEST_USER_EMPLOYEE_ID=0000
INITIAL_MANUAL_TEST_USER_PASSWORD=password
INITIAL_MANUAL_TEST_USER_EMAIL=email@example.com
INITIAL_MANUAL_TEST_USER_PHONE=0000000000
INITIAL_MANUAL_TEST_USER_FIRST_NAME=Advisor
INITIAL_MANUAL_TEST_USER_LAST_NAME=Advisor
